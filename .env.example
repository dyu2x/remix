# ==========================================
# Remix1 + MariaDB Environment Configuration
# ==========================================

# Application
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_PORT=3000

# Application URL
APP_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Admin route
ADMIN_PATH=/connect/admin

# ==========================================
# MariaDB Database Configuration
# ==========================================

MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=remix1
MARIADB_USER=remixapp
MARIADB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_RANDOM_ROOT_PASSWORD

# Database connection URL
DATABASE_URL=mysql://remixapp:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@mariadb:3306/remix1

# Generic database variables
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=remix1
DB_USER=remixapp
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# ==========================================
# Authentication / Session
# ==========================================

SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_SECRET_AT_LEAST_32_BYTES

# ==========================================
# Optional SMTP Email Configuration
# ==========================================

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ==========================================
# Optional External URL / Reverse Proxy
# ==========================================

TRUST_PROXY=false
CORS_ORIGIN=http://localhost:3000

# ==========================================
# Logging
# ==========================================

LOG_LEVEL=info
