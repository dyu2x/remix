# ==========================================
# dyu2x/remix - Environment Configuration
# Docker Compose + PostgreSQL
# ==========================================

# Application
NODE_ENV=production
PORT=3000
WEB_PORT=3000

# ==========================================
# PostgreSQL Database
# ==========================================

POSTGRES_DB=remixapp
POSTGRES_USER=remixuser
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# ==========================================
# Database Connection
# ==========================================

# Docker Compose service hostname is "db".
# The application must support DATABASE_URL.
DATABASE_URL=postgresql://remixuser:CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD@db:5432/remixapp

# ==========================================
# Optional Application Settings
# ==========================================

# Set only if the application supports these variables.
# APP_URL=http://localhost:3000
# SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
# TZ=UTC
